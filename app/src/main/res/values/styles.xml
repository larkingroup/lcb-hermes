<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4c709d</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#ece9d8</item>
        <item name="android:buttonStyle">@style/LCBButton</item>
        <item name="android:buttonBarButtonStyle">@style/LCBButton</item>
    </style>
    <style name="LCBButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
    </style>
    <color name="icon_paper">#faf9f1</color>
</resources>
